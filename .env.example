# Only needed for the local demo harness (/api/demo and the home page).
# The real ChatGPT App (/api/mcp) does NOT use this - ChatGPT is the model there.
OPENAI_API_KEY=sk-...
# Optional: override the model used by the demo harness (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: absolute base URL used to build download links.
# On Vercel this is derived automatically from VERCEL_URL.
# APP_BASE_URL=https://your-app.vercel.app
